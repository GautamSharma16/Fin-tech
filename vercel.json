{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/create-order",     "destination": "/api/create-order.js" },
    { "source": "/api/verify-payment",   "destination": "/api/verify-payment.js" },
    { "source": "/api/submit-to-sheets", "destination": "/api/submit-to-sheets.js" },
    { "source": "/api/submit-lead",      "destination": "/api/submit-lead.js" },
    { "source": "/api/notify-user",      "destination": "/api/notify-user.js" },
    { "source": "/api/razorpay-webhook", "destination": "/api/razorpay-webhook.js" },
    { "source": "/(.*)",                 "destination": "/index.html" }
  ]
}
